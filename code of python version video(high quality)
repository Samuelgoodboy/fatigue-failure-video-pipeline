        active = t >= trig_t

        bg_c = (22, 40, 60) if active else (15, 26, 40)
        bd_c = col if active else (50, 70, 90)
        cv2.rectangle(canvas, (cx1, cy1), (cx2, cy2), bg_c, -1)
        cv2.rectangle(
            canvas,
            (cx1, cy1),
            (cx2, cy2),
            bd_c,
            3 if active else 1,
            cv2.LINE_AA,
        )
        text_tasks.append((
            (cx1 + 30, cy1 + 35),
            p_title,
            F_H2,
            col if active else (100, 120, 140),
            False,
        ))
        text_tasks.append((
            (cx1 + 30, cy1 + 105),
            p_desc,
            F_BODY,
            (225, 235, 245) if active else (90, 105, 120),
            False,
        ))

      # 161.0s 起：底部最終總結橫幅 ("The key idea is simple... S-N diagram... endurance limit... fracture toughness...")
      if t >= 161.0:
        cv2.rectangle(canvas, (90, 645), (1830, 855), (24, 46, 68), -1)
        cv2.rectangle(
            canvas, (90, 645), (1830, 855), (56, 189, 248), 3, cv2.LINE_AA
        )
        text_tasks.append((
            (960, 685),
            "SUMMARY:  Repeated Loading (Δσ)  →  Crack Growth (da/dN = C(ΔK)ᵐ)  →  Fast Fracture (K ≥ K_IC)",
            F_BODY_B,
            (250, 204, 21),
            True,
        ))
        sqrt_tasks.append((
            530,
            745,
            "Critical Condition:   K_max = Y · σ · ",
            "π · a_c",
            " ≥ K_IC",
            F_MATH_M,
            (74, 222, 128),
        ))

    # --- 底部英文字幕區 ---
    cv2.rectangle(canvas, (0, H - 120), (W, H), (8, 15, 24), -1)
    cv2.line(canvas, (0, H - 120), (W, H - 120), (40, 65, 90), 2)
    cur_sub = ""
    for s_sub, e_sub, txt in subtitles:
      if s_sub <= t <= e_sub:
        cur_sub = txt
        break
    if cur_sub:
      text_tasks.append(
          ((W // 2, H - 60), cur_sub, F_SUB, (248, 250, 252), True)
      )

    # 將畫布轉為 PIL Image 進行高品質真字型與數學符號 (σ, √, π, Δ, ≥) 渲染
    pil_img = Image.fromarray(canvas)
    draw = ImageDraw.Draw(pil_img)

    for pos, txt, font, col, is_center in text_tasks:
      draw_text(draw, pos, txt, font, col, anchor_center=is_center)

    # 先轉回 numpy 畫根號頂部橫線，再合併文字
    canvas_with_text = np.array(pil_img)
    pil_img2 = Image.fromarray(canvas_with_text)
    draw2 = ImageDraw.Draw(pil_img2)
    for sx, sy, pref, inside, suff, fnt, col in sqrt_tasks:
      draw_sqrt_expr(
          canvas_with_text, draw2, sx, sy, pref, inside, suff, fnt, col
      )
      pil_img2 = Image.fromarray(canvas_with_text)
      draw2 = ImageDraw.Draw(pil_img2)
      draw_sqrt_expr(
          canvas_with_text, draw2, sx, sy, pref, inside, suff, fnt, col
      )

    return np.array(pil_img2)

