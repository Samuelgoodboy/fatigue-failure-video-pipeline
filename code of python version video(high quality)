  def draw_text(
      draw, pos, text, font, fill=(245, 248, 252), anchor_center=False
  ):
    if anchor_center:
      bbox = draw.textbbox((0, 0), text, font=font)
      tw, th = bbox[2] - bbox[0], bbox[3] - bbox[1]
      pos = (pos[0] - tw // 2, pos[1] - th // 2)
    draw.text(pos, text, font=font, fill=fill)

  # 繪製含真正根號橫線 (Vinculum) 的數學根號表達式： √(內容)
  def draw_sqrt_expr(
      canvas, draw, x, y, prefix_str, inside_str, suffix_str, font, col
  ):
    draw.text((x, y), prefix_str, font=font, fill=col)
    pb = draw.textbbox((x, y), prefix_str, font=font)
    cur_x = pb[2] + 4

    # 繪製根號勾 √
    sb = draw.textbbox((cur_x, y), "√", font=font)
    draw.text((cur_x, y), "√", font=font, fill=col)
    rad_right = sb[2]
    rad_top = sb[1] + 2

    # 繪製根號內部文字與頂部橫線
    ib = draw.textbbox((rad_right + 4, y), inside_str, font=font)
    draw.text((rad_right + 4, y), inside_str, font=font, fill=col)
    cv2.line(
        canvas, (rad_right - 2, rad_top), (ib[2] + 4, rad_top), col, 3, cv2.LINE_AA
    )

    if suffix_str:
      draw.text((ib[2] + 10, y), suffix_str, font=font, fill=col)

  def draw_vector_h_arrow(
      canvas, x_start, x_tip, y_center, col, shaft_h=8, head_w=24, head_h=22
  ):
    direction = 1 if x_tip > x_start else -1
    x_neck = x_tip - direction * head_w
    poly = np.array(
        [
            [x_start, y_center - shaft_h],
            [x_neck, y_center - shaft_h],
            [x_neck, y_center - head_h],
            [x_tip, y_center],
            [x_neck, y_center + head_h],
            [x_neck, y_center + shaft_h],
            [x_start, y_center + shaft_h],
        ],
        dtype=np.int32,
    )
    cv2.fillPoly(canvas, [poly], col, cv2.LINE_AA)

